<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunabot_navigation</name>
  <version>0.1.0</version>
  <description>Autonomy: robot_localization EKF, SLAM/map, Nav2 params, and the
    Lunabotics mission behavior tree (traverse -> excavate -> deposit).</description>
  <maintainer email="alexhalley@outlook.fr">Alexander Halley</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
