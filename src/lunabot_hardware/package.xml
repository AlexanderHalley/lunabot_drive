<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunabot_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control SystemInterface for the real Lunabot drivetrain:
    SparkFlex motor controllers over CAN. This is where the 2026 drive_node CAN
    logic migrates (into read()/write()).</description>
  <maintainer email="alexhalley@outlook.fr">Alexander Halley</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>sparkcan</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- registers the plugin so ros2_control can load it by name -->
    <hardware_interface plugin="${prefix}/lunabot_hardware.xml"/>
  </export>
</package>
