      "pinnedIds": [],
      "topicToRender": "/diagnostics",
      "hardwareIdFilter": "",
      "sortByLevel": true,
      "secondsUntilStale": 5
    },
    "CallService!estop": {
      "foxglovePanelTitle": "E-STOP",
      "lichtblickPanelTitle": "E-STOP",
      "serviceName": "/e_stop/set",
      "requestPayload": "{\"data\": true}",
      "layout": "vertical",
      "buttonText": "E-STOP",
      "buttonColor": "#dc2626",
      "buttonTooltip": "Cut every velocity source (twist_mux lock) and pause the mission."
    },
    "CallService!release": {
      "foxglovePanelTitle": "Release e-stop",
      "lichtblickPanelTitle": "Release e-stop",
      "serviceName": "/e_stop/set",
