<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunabot_navigation</name>
  <version>0.1.0</version>
  <description>
    Nav2 parameters and launch for the Lunabot rover. Started by
    `robot.launch.py nav:=true`, and untuned: the frame names, footprint and
    velocity limits agree with the rest of the workspace and are tested to,
    but no rover has navigated with them yet. See docs/NAVIGATION.md.
  </description>
  <maintainer email="alexhalley@outlook.fr">Alexander Halley</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The nodes navigation.launch.py starts, named individually rather than
       pulled in as all of nav2_bringup. That file starts the Nav2 nodes
       itself so the /cmd_vel_nav remappings are ours: nav2_bringup's own
       launch puts velocity_smoother onto /cmd_vel, which belongs to
       twist_mux. -->
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <!-- mission.py: the excavation actions (served by lunabot_excavation). -->
  <exec_depend>lunabot_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- fiducial_localizer.py -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- The plugins nav2_params.yaml loads. Undeclared, they used to arrive
       through nav2_bringup; once that went, the rover image had no Smac
       planner and the stack died at start (test_nav2_params.py checks every
       plugin's package is declared here). -->
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <!-- RewrittenYaml, which navigation.launch.py uses to push use_sim_time
       into the costmaps' own parameter blocks. -->
  <exec_depend>nav2_common</exec_depend>

  <!-- The Navigation 2 panel in lunabot_description/rviz/nav.rviz. Declared
       here rather than in lunabot_description so that a description package
       does not acquire a dependency on the whole of Nav2; RViz degrades to
       "failed to load panel" and keeps every display when it is absent. -->
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <!-- map_saver_cli, which maps/README.md tells you to run. NOT
       nav2_bringup, which this used to name for it: map_saver_cli lives in
       nav2_map_server, and nav2_bringup drags in Gazebo and the TurtleBot
       simulations (ros_gz_sim, nav2_minimal_tb3/tb4_sim): hundreds of MB
       in the rover image for nothing. -->
  <exec_depend>nav2_map_server</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>python3-opencv</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
