# Development and CI image for the ROS 2 side of the workspace.
#
# Does NOT contain Isaac Sim. Isaac runs from its own image
# (docker/Dockerfile.isaac) or a native install, and talks to this one over
# DDS. Keeping them apart means this image stays a few hundred megabytes
# rather than tens of gigabytes, and the same image serves CI, the
# devcontainer, and the robot.
FROM ros:jazzy-ros-base

ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=1000

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      git \
      python3-pip \
      python3-colcon-common-extensions \
      python3-vcstool \
      python3-rosdep \
      # SocketCAN tooling. can-utils gives candump, which is how the drive
      # layer gets debugged; iproute2 brings up the interface.
      can-utils \
      iproute2 \
      liburdfdom-tools \
      # CycloneDDS. The 2026 setup used it for large image topics and there is
      # no reason to change.
      ros-jazzy-rmw-cyclonedds-cpp \
      ros-jazzy-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*

# Non-root user. Running as root inside a container that bind-mounts the
# source tree leaves root-owned build artefacts on the host, which is
# tediously annoying to clean up.
RUN if ! getent group ${USER_GID}; then groupadd --gid ${USER_GID} ${USERNAME}; fi \
    && if ! id -u ${USER_UID} >/dev/null 2>&1; then \
         useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME}; \
       fi \
    && apt-get update && apt-get install -y --no-install-recommends sudo \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Resolve dependencies in a separate layer from the source, so editing code
# does not invalidate the apt cache. Only the manifests are copied here.
COPY --chown=${USER_UID}:${USER_GID} lunabot.repos /workspace/lunabot.repos
COPY --chown=${USER_UID}:${USER_GID} src/*/package.xml /tmp/manifests/

RUN mkdir -p /workspace/src \
    && vcs import /workspace/src < /workspace/lunabot.repos \
    && apt-get update \
    && rosdep update --rosdistro=jazzy \
    # Same skip-keys as CI and the README. sparkcan comes from lunabot.repos
    # and builds from source; isaac_ros_visual_slam may have no release for
    # this distro at all.
    && rosdep install --from-paths /tmp/manifests /workspace/src \
         --ignore-src -y \
         --skip-keys "sparkcan isaac_ros_visual_slam" \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=${USER_UID}:${USER_GID} docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER ${USERNAME}

ENV ROS_DOMAIN_ID=42 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    COLCON_DEFAULTS_FILE=/workspace/colcon_defaults.yaml

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
