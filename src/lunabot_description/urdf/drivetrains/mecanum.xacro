<?xml version="1.0"?>
<!--
  Mecanum / holonomic drivetrain.  PLACEHOLDER.

  Pairs with mecanum_drive_controller in lunabot_control (commands 4 wheels
  independently for omnidirectional motion).

  TODO:
    - 4 wheel links/joints: front_left/front_right/rear_left/rear_right.
    - Roller visuals or a mecanum mesh (rollers not simulated as separate joints).
    - Keep macro signature identical to diff.xacro for the drive_type swap.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="drivetrain" params="wheel_separation wheel_radius">
    <!-- TODO: define front_left_wheel_joint / front_right_wheel_joint / rear_*_joint -->
    <link name="mecanum_placeholder"/>
    <joint name="mecanum_placeholder_joint" type="fixed">
      <parent link="chassis"/><child link="mecanum_placeholder"/>
    </joint>
  </xacro:macro>
</robot>
