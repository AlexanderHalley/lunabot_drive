<?xml version="1.0"?>
<!--
  Differential drivetrain: two independently driven wheels + a caster.
  Also the base for skid-steer (skid.xacro reuses this pattern with 4/6 wheels).

  Provides continuous joints named:  left_wheel_joint, right_wheel_joint
  (diff_drive_controller expects exactly these in lunabot_control config).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="name x y radius">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${radius}" length="0.05"/></geometry>
        <origin rpy="1.5708 0 0"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${radius}" length="0.05"/></geometry>
        <origin rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="chassis"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="drivetrain" params="wheel_separation wheel_radius">
    <xacro:wheel name="left_wheel"  x="0" y="${ wheel_separation/2}" radius="${wheel_radius}"/>
    <xacro:wheel name="right_wheel" x="0" y="${-wheel_separation/2}" radius="${wheel_radius}"/>
    <!-- TODO: replace caster with real support geometry / rear wheels -->
    <link name="caster">
      <visual><geometry><sphere radius="${wheel_radius/2}"/></geometry></visual>
      <collision><geometry><sphere radius="${wheel_radius/2}"/></geometry></collision>
      <inertial><mass value="0.2"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent link="chassis"/><child link="caster"/>
      <origin xyz="-0.3 0 ${-wheel_radius/2}"/>
    </joint>
  </xacro:macro>

</robot>
