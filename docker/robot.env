# The rover (Jetson Orin). docker compose -f docker/compose.robot.yml --env-file docker/robot.env up -d
#
# The image tag is the deployment: CI pushes ghcr.io/alexanderhalley/lunabot_drive/robot:<branch>
# and :<commit sha> for every push to develop-2027. Pin a sha for a competition run, so a
# re-pull cannot change what is on the rover; roll back by setting the previous one.
LUNABOT_IMAGE=ghcr.io/alexanderhalley/lunabot_drive/robot:develop-2027
# The same ~/lunabotics tree as the desktop (lunabotics-filesystem-setup.md).
LUNABOT_DATA=${HOME}/lunabotics/data
ROS_DOMAIN_ID=42
LUNABOT_CYCLES=3
LUNABOT_LAUNCH=robot.launch.py hw:=real nav:=true slam:=rtabmap foxglove:=true foxglove_profile:=field wait_for_start:=true record:=true bag_dir:=/data/bags
