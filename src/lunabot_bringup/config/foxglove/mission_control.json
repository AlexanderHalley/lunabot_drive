      "style": "background",
      "fallbackColor": "#6b7280",
      "fallbackLabel": "NO MISSION NODE",
      "rules": [
        {
          "operator": "=",
          "rawValue": "READY",
          "color": "#2563eb",
          "label": "READY: press Start"
        },
        {
          "operator": "=",
          "rawValue": "RUNNING",
          "color": "#16a34a",
          "label": "RUNNING"
        },
        {
          "operator": "=",
          "rawValue": "PAUSED",
          "color": "#d97706",
          "label": "PAUSED"
        },
        {
          "operator": "=",
          "rawValue": "E-STOP",
          "color": "#dc2626",
          "label": "E-STOP"
        },
        {
          "operator": "=",
          "rawValue": "ABORTED",
          "color": "#dc2626",
          "label": "ABORTED"
        },
        {
          "operator": "=",
          "rawValue": "FAILED",
          "color": "#dc2626",
          "label": "FAILED"
        },
        {
          "operator": "=",
          "rawValue": "COMPLETE",
          "color": "#16a34a",
          "label": "COMPLETE"
        }
      ]
    },
    "Indicator!estop": {
      "foxglovePanelTitle": "Software e-stop",
      "lichtblickPanelTitle": "Software e-stop",
      "path": "/e_stop.data",
      "style": "bulb",
      "fallbackColor": "#6b7280",
      "fallbackLabel": "e-stop: never pressed",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#dc2626",
          "label": "E-STOP ENGAGED"
        },
        {
          "operator": "=",
          "rawValue": "false",
          "color": "#16a34a",
          "label": "e-stop released"
        }
      ]
    },
    "RawMessages!state": {
      "foxglovePanelTitle": "Mission state",
      "lichtblickPanelTitle": "Mission state",
      "topicPath": "/mission/state.data",
      "diffMethod": "custom",
      "diffTopicPath": "",
      "diffEnabled": false,
      "showFullMessageForDiff": false,
      "fontSize": 18
    },
    "CallService!start": {
      "foxglovePanelTitle": "Start",
      "lichtblickPanelTitle": "Start",
      "serviceName": "/mission/start",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Start",
      "buttonColor": "#16a34a",
      "buttonTooltip": "Start the mission (mission.py with autostart:=false waits for this)."
    },
    "CallService!pause": {
      "foxglovePanelTitle": "Pause",
      "lichtblickPanelTitle": "Pause",
      "serviceName": "/mission/pause",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Pause",
      "buttonColor": "#d97706",
      "buttonTooltip": "Cancel the current leg and hold; dig/dump timers stop."
    },
    "CallService!resume": {
      "foxglovePanelTitle": "Resume",
      "lichtblickPanelTitle": "Resume",
      "serviceName": "/mission/resume",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Resume",
      "buttonColor": "#2563eb",
      "buttonTooltip": "Carry on: the interrupted leg is planned again from here."
    },
    "CallService!abort": {
      "foxglovePanelTitle": "Abort",
      "lichtblickPanelTitle": "Abort",
      "serviceName": "/mission/abort",
      "requestPayload": "{}",
      "layout": "vertical",
      "buttonText": "Abort",
      "buttonColor": "#dc2626",
      "buttonTooltip": "End the mission. Final: restart mission.py to run again."
    },
    "Image!camera": {
      "foxglovePanelTitle": "Onboard camera (2 fps, 424 px)",
      "lichtblickPanelTitle": "Onboard camera (2 fps, 424 px)",
