        {
          "value": "/cmd_vel.twist.linear.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "commanded"
        },
        {
          "value": "/odom.twist.twist.angular.z",
          "enabled": false,
          "timestampMethod": "receiveTime",
          "label": "yaw rate (rad/s)"
