# Sources that rosdep cannot resolve, imported with:
#
#   vcs import src < lunabot.repos
#
# Anything listed here must also appear in the rosdep skip-keys list used by CI
# and the README:
#
#   --skip-keys "sparkcan isaac_ros_visual_slam"
#
# Keep those two lists in sync. They are the same list wearing different hats.
repositories:
  # REV SparkMax/SparkFlex SocketCAN library. Not in the rosdep index.
  #
  # The provenance was never recorded when the 2026 robot built this from a
  # local checkout, and the first URL guessed here did not exist -- CI died at
  # `vcs import` before it built anything. This one is confirmed to exist, to
  # ship SparkFlex.cpp/.hpp, and to export the `sparkcan::sparkcan` target that
  # lunabot_hardware/CMakeLists.txt links against.
  #
  # Note the branch is `master`, not `main`.
  sparkcan:
    type: git
    url: https://github.com/grayson-arendt/sparkcan.git
    version: master

  # Hardware interface that bridges ros2_control to a simulator over topics.
  #
  # This entry is REQUIRED, not a convenience: the package has no Jazzy
  # release. It does not appear in jazzy/distribution.yaml in ros/rosdistro,
  # so `apt-cache policy ros-jazzy-topic-based-ros2-control` finds nothing and
  # rosdep cannot resolve it. It does build from source against Jazzy -- CI
  # builds it on every run through this file.
  #
  # Recheck at the start of a distro cycle rather than per-PR; if it is ever
  # released, delete this entry and let rosdep handle it.
  topic_based_ros2_control:
    type: git
    url: https://github.com/PickNikRobotics/topic_based_ros2_control.git
    version: main

# NOT listed here on purpose:
#
#   isaac_ros_visual_slam -- it is NOT IN THE JAZZY DISTRIBUTION AT ALL.
#   Checked against rosdistro's jazzy/distribution.yaml: no isaac_ros_*
#   package is in the index rosdep resolves against, and the upstream repo has
#   no jazzy branch. Isaac ROS ships from NVIDIA's own apt repository on its
#   own cadence.
#
#   So it cannot be vcs-imported to fix anything either: this is not a
#   temporary gap waiting on a release we can pull in, and the skip-key for it
#   is permanent. See docs/SLAM.md.
