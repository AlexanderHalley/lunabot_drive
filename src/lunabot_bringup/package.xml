<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunabot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level orchestration: composes description + control +
    perception + navigation into a full sim or hardware bring-up. One config
    (robot.yaml) selects the drivetrain and mode.</description>
  <maintainer email="alexhalley@outlook.fr">Alexander Halley</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>lunabot_description</exec_depend>
  <exec_depend>lunabot_control</exec_depend>
  <exec_depend>lunabot_perception</exec_depend>
  <exec_depend>lunabot_navigation</exec_depend>
  <exec_depend>lunabot_simulation</exec_depend>
  <exec_depend>lunabot_hardware</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
