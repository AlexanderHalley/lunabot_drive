# The desktop: the rover image against native Isaac. Start Isaac first
# (src/lunabot_sim/scripts/run_isaac_sim.sh), then
#   docker compose -f docker/compose.robot.yml --env-file docker/sim.env up
# Build the image locally (docs/DEPLOYMENT.md) or use CI's amd64 image.
LUNABOT_IMAGE=ghcr.io/alexanderhalley/lunabot_drive/robot:develop-2027
LUNABOT_DATA=${HOME}/lunabotics/data
ROS_DOMAIN_ID=42
LUNABOT_SIM_TIME=true
LUNABOT_CYCLES=2
LUNABOT_LAUNCH=sim.launch.py slam:=rtabmap nav:=true rviz:=false foxglove:=true foxglove_profile:=field wait_for_start:=true record:=true bag_dir:=/data/bags
