<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lunabot_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch orchestration and configuration for the Lunabot rover. The only
    package a human types `ros2 launch` against.
  </description>
  <maintainer email="alexhalley@outlook.fr">Alexander Halley</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>lunabot_description</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Provides mock_components/GenericSystem, which is what hw:=mock loads.
       Without this the default launch configuration does not work. -->
  <exec_depend>hardware_interface</exec_depend>

  <!-- Bridges ros2_control to Isaac over two JointState topics, which is what
       hw:=sim loads. Built from source via lunabot.repos; exec-only, so a
       missing binary blocks hw:=sim rather than the build. -->
  <exec_depend>topic_based_ros2_control</exec_depend>

  <!-- scripts/check_stack.py, which reads a live graph and judges it against
       docs/TOPIC_FRAME_CONTRACT.md, and scripts/robot_health.py, which does
       the same thing continuously onto /diagnostics. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <!-- Monitoring. diagnostic_msgs is what robot_health.py publishes;
       diagnostic_aggregator turns it into the /diagnostics_agg tree that
       rqt_robot_monitor is the only consumer of. lunabot_msgs and vision_msgs
       are the two message packages robot_health.py subscribes to that nothing
       else in this package needs. -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>lunabot_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <!-- Foxglove Studio's WebSocket bridge, started by foxglove:=true. Exec-only
       and off by default, so a machine without it loses foxglove.launch.py and
       nothing else. -->
  <exec_depend>foxglove_bridge</exec_depend>

  <!-- Teleop and velocity arbitration -->
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <!-- Camera. depthai_ros_driver may need building from source depending on
       the distro; it is exec-only, so a missing binary does not block the
       build, only hw:=real with the camera enabled. -->
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>

  <!-- SLAM and sensor fusion -->
  <exec_depend>lunabot_slam</exec_depend>
  <exec_depend>lunabot_perception</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <!-- Navigation. Included by robot.launch.py under nav:=true. -->
  <exec_depend>lunabot_navigation</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
